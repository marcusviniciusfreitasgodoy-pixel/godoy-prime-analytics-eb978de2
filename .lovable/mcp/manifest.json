    "tools": [
      {
        "name": "estatisticas_mercado",
        "title": "Estatísticas de mercado (ITBI)",
        "description": "Mediana, média e faixa de R$/m² de escrituras do ITBI para um bairro (e opcionalmente uma rua), com o mesmo motor da plataforma: ponderado por escrituras, sem outliers e corrigido no tempo.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "bairro": {
              "type": "string",
              "minLength": 2,
              "description": "Bairro do Rio de Janeiro, ex.: 'Barra da Tijuca'."
            },
            "logradouro": {
              "type": "string",
              "minLength": 3,
              "description": "Rua/avenida, ex.: 'Rua Desenhista Luiz Guimarães'."
            },
            "tipologia": {
              "type": "string",
              "enum": [
                "Apartamento",
                "Casa",
                "Comercial"
              ],
              "description": "Tipo de imóvel."
            },
            "janela_meses": {
              "type": "number",
              "enum": [
                12,
                24,
                36,
                48,
                60
              ],
              "description": "Período em meses (padrão 12)."
            }
          },
          "required": [
            "bairro"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "listar_transacoes_mercado",
        "title": "Listar transações de mercado (ITBI)",
        "description": "Escrituras individuais do ITBI em páginas, das mais recentes às mais antigas, com total exato de registros. Cada registro traz só dados do imóvel e da transação (data, logradouro, número, tipologia, área e valor) — sem nomes das partes nem dados pessoais. Valores nominais (preço da época), deflacionado: false. Use proxima_pagina até null para consultar todo o período.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "bairro": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100,
              "description": "Bairro do Rio de Janeiro, ex.: 'Barra da Tijuca'."
            },
            "logradouro": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200,
              "description": "Rua/avenida, ex.: 'Avenida Lúcio Costa'."
            },
            "tipologia": {
              "type": "string",
              "enum": [
                "Apartamento",
                "Casa",
                "Comercial"
              ],
              "description": "Tipo de imóvel."
            },
            "ano": {
              "type": "integer",
              "minimum": 2015,
              "maximum": 2100,
              "description": "Ano da transação (padrão: ano corrente)."
            },
            "data_inicio": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Data inicial (YYYY-MM-DD), inclusive."
            },
            "data_fim": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Data final (YYYY-MM-DD), inclusive."
            },
            "pagina": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90071992547409.9,
              "description": "Página a consultar, começando em 1 (padrão 1)."
            },
            "limite": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Registros por página, de 1 a 100 (padrão 20)."
            }
          },
          "required": [
            "bairro"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
