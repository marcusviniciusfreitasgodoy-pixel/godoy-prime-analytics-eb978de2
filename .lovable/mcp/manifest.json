  "mcp": {
    "server": {
      "name": "godoy-prime-analytics",
      "version": "0.1.0",
      "title": "Godoy Prime Analytics"
    },
    "tools": [
      {
        "name": "estatisticas_mercado",
        "title": "Estatísticas de mercado (ITBI)",
        "description": "Mediana, média e faixa de R$/m² de escrituras do ITBI para um bairro (e opcionalmente uma rua), com o mesmo motor da plataforma: ponderado por escrituras, sem outliers e corrigido no tempo.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "bairro": {
              "type": "string",
              "minLength": 2,
              "description": "Bairro do Rio de Janeiro, ex.: 'Barra da Tijuca'."
            },
            "logradouro": {
              "type": "string",
              "minLength": 3,
              "description": "Rua/avenida, ex.: 'Rua Desenhista Luiz Guimarães'."
            },
            "tipologia": {
              "type": "string",
              "enum": [
                "Apartamento",
                "Casa",
                "Comercial"
              ],
              "description": "Tipo de imóvel."
            },
            "janela_meses": {
              "type": "number",
              "enum": [
                12,
                24,
                36,
                48,
                60
              ],
              "description": "Período em meses (padrão 12)."
            }
          },
          "required": [
            "bairro"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "listar_visitas",
